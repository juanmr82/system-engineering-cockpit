# --- Maven / Kotlin / JVM ---
target/
out/
# The Maven wrapper is the "only-script" flavour: two shell scripts and a properties file,
# no jar. That is deliberate - see docs/adr/0007-maven-over-gradle.md.

# --- IntelliJ (keep .run/ and the .iml/module files, ignore caches) ---
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/
.idea/**/dictionaries
.idea/**/contentModel.xml
.idea/httpRequests/
.idea/caches/
.idea/libraries/
.idea/artifacts/
.idea/compiler.xml
.idea/jarRepositories.xml

# --- Node / Angular ---
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# --- Python / importers ---
importers/.venv/
importers/**/__pycache__/
importers/**/*.pyc
importers/.pytest_cache/
importers/*.egg-info/
# An editable install writes this under src/, which the line above does not reach.
importers/**/*.egg-info/
importers/dist/

# --- Local machine setup (site paths, proxy, credentials) ---
scripts/win/sec-env.local.ps1
docs/JIRA_TOKEN_FOR_EXAMPLE_GIT_IGNORE.md

# --- Reports / local artifacts ---
importers/reports/
*.log

# --- OS ---
.DS_Store
Thumbs.db
