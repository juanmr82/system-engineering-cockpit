# --- Maven / Kotlin / JVM ---
target/
out/
# The Maven wrapper is the "only-script" flavour: two shell scripts and a properties file,
# no jar. That is deliberate - see docs/adr/0007-maven-over-gradle.md.

# --- IntelliJ (keep .run/ and the .iml/module files, ignore caches) ---
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/
.idea/**/dictionaries
.idea/**/contentModel.xml
.idea/httpRequests/
.idea/caches/
.idea/libraries/
.idea/artifacts/
.idea/compiler.xml
.idea/jarRepositories.xml

# --- Node / Angular ---
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# --- Python / importers ---
importers/.venv/
importers/**/__pycache__/
importers/**/*.pyc
importers/.pytest_cache/
importers/*.egg-info/
# An editable install writes this under src/, which the line above does not reach.
importers/**/*.egg-info/
importers/dist/

# --- Local machine setup (site paths, proxy, credentials) ---
scripts/win/sec-env.local.ps1

# --- Reports / local artifacts ---
importers/reports/
*.log

# --- Local JIRA export used by JiraRealExportTest ---
# A real search response dropped here makes those 8 tests run; without it they skip. Not committed:
# it is one instance's own issue data and megabytes of it, and the tests that must always run are
# the ones in JiraFieldsTest.
docs/TEST_JIRA_DATA.json

# --- OS ---
.DS_Store
Thumbs.db
