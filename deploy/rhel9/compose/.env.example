# /opt/sec/compose/.env — compose's own variables.
#
#   install -o root -g root -m 0600 .env.example /opt/sec/compose/.env
#
# TOPOLOGY AND IMAGE TAGS ONLY. The application's secrets are NOT here — they are in
# /etc/sec/sec.env, which the backend service reads through `env_file:`. Two files, because they
# have different readers and different lifetimes: this one is read by the docker CLI as the
# invoking user, that one is handed to one container.
#
# The two exceptions below (the Neo4j and Keycloak database passwords) are here because compose
# itself must interpolate them into `environment:` blocks at up-time. Hence mode 0600.

# --- who we are ---------------------------------------------------------------------------------
# The public hostname, matching the certificate and the nginx server_name. Keycloak builds every
# URL it issues from this, so a wrong value produces a login loop rather than an error.
SEC_HOSTNAME=sec.example.corp

# --- images -------------------------------------------------------------------------------------
# Pinned by tag. On an air-gapped host these must already be in the local docker store or on the
# company registry mirror — `docker compose pull` reaches nothing otherwise (DEPLOY_RHEL9.md §4.3).
#
# Neo4j must stay on the series the project pins in the root pom.xml (neo4j-image.version): the
# container tests run against that image, and testing against a different major than production
# defeats the point of testing against Community at all.
SEC_NEO4J_IMAGE=neo4j:2026.01-community
SEC_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
SEC_POSTGRES_IMAGE=postgres:16-alpine
SEC_BACKEND_IMAGE=sec/backend:0.1.0

# --- Neo4j -----------------------------------------------------------------------------------------
# These must match SEC_NEO4J_USER / SEC_NEO4J_PASSWORD in /etc/sec/sec.env — the container's
# credential and the backend's credential are the same credential, stated twice because two
# different processes need it. Getting them out of step means the backend dies at startup with an
# authentication failure, which is at least loud.
#
# NOTE: NEO4J_AUTH only takes effect on an EMPTY data volume. Changing the password here later
# does nothing; use `cypher-shell` to change it in the database, then update both files.
SEC_NEO4J_USER=neo4j
SEC_NEO4J_PASSWORD=CHANGE-ME

# Heap and page cache. Rule of thumb for this workload: page cache at least as large as the graph
# on disk, heap 2G unless imports say otherwise.
SEC_NEO4J_HEAP=2G
SEC_NEO4J_PAGECACHE=2G

# --- Keycloak ------------------------------------------------------------------------------------
SEC_KC_DB_PASSWORD=CHANGE-ME
SEC_KC_LOG_LEVEL=info

# First start only. Set these, bring Keycloak up, create a named admin user in the master realm,
# then blank both and `docker compose up -d keycloak`.
SEC_KC_ADMIN=
SEC_KC_ADMIN_PASSWORD=

# --- where the application's secrets live ------------------------------------------------------------
SEC_ENV_FILE=/etc/sec/sec.env
