# MANAGED BY ANSIBLE — edits here are overwritten on the next run.

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://{{ sec_bind_address }}:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD={{ vault_sec_kc_db_password }}

# Behind nginx, which terminates TLS.
#
# ONE path mechanism, not two: nginx does not rewrite, so Keycloak must genuinely serve on /auth
# (http-relative-path), and KC_HOSTNAME therefore carries no path. The issuer it advertises is
# hostname + relative path = https://{{ sec_hostname }}/auth/realms/<realm>, which is exactly what
# the backend is configured with — sec_verify asserts the two agree.
KC_HTTP_ENABLED=true
KC_HTTP_PORT={{ sec_keycloak_port }}
KC_HTTP_HOST={{ sec_bind_address }}
KC_PROXY_HEADERS=xforwarded
# Trust forwarded headers from the proxy only. The listener is already loopback-only; this is the
# second lock on the same door, and the guide asks for it explicitly.
KC_PROXY_TRUSTED_ADDRESSES={{ sec_bind_address }}
KC_HOSTNAME=https://{{ sec_hostname }}
KC_HTTP_RELATIVE_PATH=/auth
KC_HOSTNAME_STRICT=true

KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
{% if vault_sec_kc_admin_password | default('') | length > 0 %}

# First start only. Blank vault_sec_kc_admin_password once a named admin exists and re-run: a
# permanent bootstrap admin is a permanent shared credential.
KC_BOOTSTRAP_ADMIN_USERNAME={{ vault_sec_kc_admin_user | default('admin') }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ vault_sec_kc_admin_password }}
{% endif %}
