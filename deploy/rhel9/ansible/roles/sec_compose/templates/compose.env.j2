# MANAGED BY ANSIBLE — edits here are overwritten on the next run.
# Topology and image tags only; the application's secrets are /etc/sec/sec.env.

SEC_HOSTNAME={{ sec_hostname }}

SEC_NEO4J_IMAGE={{ sec_compose_neo4j_image }}
SEC_KEYCLOAK_IMAGE={{ sec_compose_keycloak_image }}
SEC_POSTGRES_IMAGE={{ sec_compose_postgres_image }}
SEC_BACKEND_IMAGE=sec/backend:{{ sec_jar_version }}

# Must match /etc/sec/sec.env: the container's credential and the backend's are the same one,
# stated twice because two processes need it. NEO4J_AUTH takes effect on an EMPTY volume only.
SEC_NEO4J_USER={{ vault_sec_neo4j_user }}
SEC_NEO4J_PASSWORD={{ vault_sec_neo4j_password }}
SEC_NEO4J_HEAP={{ sec_neo4j_heap }}
SEC_NEO4J_PAGECACHE={{ sec_neo4j_pagecache }}

SEC_KC_DB_PASSWORD={{ vault_sec_kc_db_password }}
SEC_KC_LOG_LEVEL=info
SEC_KC_ADMIN={{ vault_sec_kc_admin_user | default('') }}
SEC_KC_ADMIN_PASSWORD={{ vault_sec_kc_admin_password | default('') }}

SEC_ENV_FILE=/etc/sec/sec.env
