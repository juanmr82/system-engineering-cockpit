<?xml version="1.0" encoding="UTF-8"?>
<!--
  Development logging: human-readable, with the CallId in front of the message so a request can
  be followed by eye. Production uses logback-production.xml (JSON) — see that file for how it
  is selected.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{callId:-no-call-id}] %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
